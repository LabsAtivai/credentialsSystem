# Banco de dados
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Autenticação
JWT_SECRET=troque-por-uma-string-aleatoria-de-64-chars
JWT_EXPIRES_MINUTES=60

# Criptografia (AES-256-GCM) — base64 de 32 bytes.
# Gerar com: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# NUNCA commitar o valor real. Guardar em secret manager / cofre separado do backup do banco.
ENCRYPTION_KEY=

# CORS — deve incluir a URL pública do frontend
CORS_ORIGINS=http://localhost:8080

# Rate limit da API (formato slowapi)
API_RATE_LIMIT=100/minute

# Portas expostas no host
API_PORT=8000
FRONTEND_PORT=8080

# URL pública da API, usada em build-time pelo frontend (Vite embute no bundle)
VITE_API_URL=http://localhost:8000
