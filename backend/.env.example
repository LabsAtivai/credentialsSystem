# Ambiente
ENVIRONMENT=development

# Banco de dados
DATABASE_URL=postgresql+psycopg://snov_user:SENHA_FORTE@localhost:5432/snov_account_manager

# Autenticação
JWT_SECRET=troque-por-uma-string-aleatoria-de-64-chars
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Criptografia (AES-256-GCM) — base64 de 32 bytes.
# Gerar com: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# NUNCA commitar o valor real. Guardar em secret manager / cofre separado do backup do banco.
ENCRYPTION_KEY=

# CORS (lista separada por vírgula)
CORS_ORIGINS=http://localhost:5173

# Rate limit (formato slowapi, ex: "100/minute")
API_RATE_LIMIT=100/minute
